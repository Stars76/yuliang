{
  "name": "quota-dashboard",
  "private": true,
  "type": "module",
  "version": "1.8.0",
  "description": "余量 · 单机离线额度面板（Windows / Android）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GenZ/yuliang.git"
  },
  "homepage": "https://github.com/GenZ/yuliang",
  "bugs": {
    "url": "https://github.com/GenZ/yuliang/issues"
  },
  "main": "src/standalone/electron/main.js",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "verify": "npm test && npm run build:web && npm run build:android-web",
    "build:web": "npm --prefix src/web run build",
    "build:android-web": "npm --prefix src/standalone/capacitor run build",
    "electron": "electron .",
    "dist:win": "electron-builder --win",
    "release:bump": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.yuliang.app",
    "productName": "余量",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/standalone/**/*",
      "!src/standalone/capacitor/node_modules/**",
      "!src/standalone/capacitor/www/**",
      "!src/standalone/capacitor/android/**",
      "src/web/dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "src/standalone/electron/main.js"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/standalone/electron/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
